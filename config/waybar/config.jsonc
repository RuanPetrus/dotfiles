{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 8,
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "battery", "tray"],
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}"
  },
  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "MUTED"
  },
  "network": {
    "format-wifi": "{essid} {signalStrength}%",
    "format-ethernet": "ETH",
    "format-disconnected": "OFFLINE",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "BAT {capacity}%",
    "format-charging": "BAT +{capacity}%"
  },
  "tray": {
    "spacing": 8
  }
}
