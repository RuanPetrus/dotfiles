{
  "layer": "top",
  "position": "left",
  "width": 28,
  "margin": "2 0 2 2",
  "spacing": 2,
  "modules-left": ["clock", "tray"],
  "modules-center": ["sway/workspaces"],
  "modules-right": ["pulseaudio", "network", "battery"],
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "focused": "●",
      "urgent": "!",
      "default": "○"
    }
  },
  "clock": {
    "format": "{:%H\n%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },
  "pulseaudio": {
    "format": "󰕾",
    "format-muted": "󰖁"
  },
  "network": {
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-icons": ["󰁺", "󰁻", "󰁽", "󰁿", "󰂀", "󰁹"]
  },
  "tray": {
    "icon-size": 14,
    "spacing": 2
  }
}
